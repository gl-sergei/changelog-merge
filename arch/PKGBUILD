# Maintainer: Sergei <sergei@local>
# Local build of the upstream release with the repository's `patched` branch
# applied. The branch currently carries:
#   - keep section boundary blank lines out of the last entry span, so
#     concurrent first entries merge without a blank line between them.
# The patch file is regenerated by ./update from that branch; never edit it
# by hand. Rebuild with ./update (it rebases, re-exports the patch, refreshes
# these checksums and runs makepkg).
pkgname=changelog-merge-patched
pkgver=0.1.0
pkgrel=1
pkgdesc="Semantic three-way merging for Keep a Changelog (local patched build)"
arch=('x86_64')
url="https://github.com/cachix/changelog-merge"
license=('Apache-2.0')
depends=('gcc-libs')
makedepends=('cargo' 'git')
provides=("changelog-merge=$pkgver")
conflicts=('changelog-merge')
_pkgname=changelog-merge
source=("$_pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        'changelog-merge-patched.patch')
sha256sums=('51ee8e64583f1b58a79d6eb45ffeca40aacdd1ccbc34bd6550bdec207ffdf17e'
            'e7ed0fec4c3dbf0be94011b4e13df9aba4d820a000a72bb9d0fac422afaa58f7')

prepare() {
  export CARGO_HOME="$srcdir/cargo-home"
  # An empty patch means the branch carries nothing beyond the release.
  if [ -s "$srcdir/changelog-merge-patched.patch" ]; then
    patch -Np1 -d "$_pkgname-$pkgver" -i "$srcdir/changelog-merge-patched.patch"
  fi
  cargo fetch --locked --manifest-path "$_pkgname-$pkgver/Cargo.toml"
}

build() {
  export CARGO_HOME="$srcdir/cargo-home"
  export RUSTUP_TOOLCHAIN=stable
  cd "$_pkgname-$pkgver"
  cargo build --frozen --release
}

check() {
  export CARGO_HOME="$srcdir/cargo-home"
  export RUSTUP_TOOLCHAIN=stable
  cd "$_pkgname-$pkgver"
  cargo test --frozen
}

package() {
  cd "$_pkgname-$pkgver"
  install -Dm755 target/release/changelog-merge "$pkgdir/usr/bin/changelog-merge"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
